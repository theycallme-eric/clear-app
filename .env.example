# Clear App - Environment Configuration
# =====================================
#
# SETUP INSTRUCTIONS:
#
# For LOCAL DEVELOPMENT (with local Supabase):
#   1. Copy this file to .env.local
#   2. Run: npx supabase start
#   3. Use the values shown by: npx supabase status
#
# For PRODUCTION (Vercel):
#   Set these in Vercel Dashboard > Settings > Environment Variables
#   Get values from Supabase Dashboard > Settings > API
#
# =====================================

# Supabase Project URL
# Local: http://127.0.0.1:54321
# Production: https://your-project-id.supabase.co
VITE_SUPABASE_URL=

# Supabase Anon Key (public, safe to expose)
# Local: Use the JWT key from `npx supabase status` or the demo key below
# Production: Get from Supabase Dashboard > Settings > API > anon/public key
VITE_SUPABASE_ANON_KEY=

# =====================================
# LOCAL DEVELOPMENT VALUES
# =====================================
# These are the default local Supabase values. Copy to .env.local:
#
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# =====================================
# EDGE FUNCTION SECRETS
# =====================================
# These are NOT loaded from .env files.
#
# For LOCAL: Set via Supabase CLI:
#   npx supabase secrets set ANTHROPIC_API_KEY=your-key
#
# For PRODUCTION: Set in Supabase Dashboard:
#   Dashboard > Edge Functions > Secrets
#
# Required secrets:
#   ANTHROPIC_API_KEY - For AI workout generation
