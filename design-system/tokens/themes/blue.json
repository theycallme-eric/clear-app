{
  "$description": "CLEAR Design System — Blue Theme. Structure = blue, Interaction = orange. The theme swap flips structure and interaction roles entirely — it's not a 'dark mode' toggle, it's a personality shift.",

  "surface": {
    "card":                   { "$value": "{color.blue-alpha.100}" },
    "card-accent":            { "$value": "{color.blue-alpha.400}" },
    "heading":                { "$value": "{color.blue-alpha.100}" },

    "cta-primary":            { "$value": "{color.orange-alpha.400}" },
