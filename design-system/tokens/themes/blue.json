    "cta-secondary":          { "$value": "rgba(248, 120, 35, 0.05)" },
    "cta-secondary-hover":    { "$value": "{color.orange-alpha.200}" },
    "selected":               { "$value": "{color.green-alpha.600}" },
    "unselected":             { "$value": "{color.blue-alpha.100}" },
    "disabled":               { "$value": "{color.neutral-alpha.300}" },

