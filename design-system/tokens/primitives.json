  "spacing": {
    "$type": "dimension",
    "$description": "4px-based spacing scale",
    "0":    { "$value": "0px" },
    "25":   { "$value": "1px" },
    "50":   { "$value": "2px" },
    "100":  { "$value": "4px" },
    "200":  { "$value": "8px" },
    "300":  { "$value": "12px" },
    "400":  { "$value": "16px" },
    "500":  { "$value": "20px" },
    "600":  { "$value": "24px" },
    "700":  { "$value": "32px" },
    "800":  { "$value": "40px" },
    "1000": { "$value": "48px" },
    "1100": { "$value": "56px" },
    "1200": { "$value": "64px" },
    "1300": { "$value": "96px" },
    "1400": { "$value": "128px" },
    "1500": { "$value": "256px" }
  },

  "borderWidth": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "xs":   { "$value": "1px" },
    "sm":   { "$value": "2px", "$description": "Default border width" },
    "md":   { "$value": "4px" },
    "lg":   { "$value": "8px" },
    "xl":   { "$value": "12px" },
    "2xl":  { "$value": "16px" },
    "3xl":  { "$value": "20px" }
  },

  "cornerCut": {
    "$type": "dimension",
    "$description": "Chamfer sizes for the signature angled corner cut. NOT border-radius — these define the diagonal cut on the bottom-right corner of frames.",
    "sm":  { "$value": "8px" },
    "md":  { "$value": "12px" },
    "lg":  { "$value": "24px" }
  },

  "radius": {
    "$type": "dimension",
    "$description": "Border radius. CLEAR uses 0px everywhere — chamfered cuts, not rounded corners.",
    "none": { "$value": "0px" }
  }
